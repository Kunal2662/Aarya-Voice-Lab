{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aarya-voice-lab/schemas/manual_review.schema.json",
  "title": "AARYA Voice Lab Manual Review Record",
  "description": "One human review decision for a candidate segment (docs/DATASET_PIPELINE.md manual review stage).",
  "type": "object",
  "required": ["schema_version", "review_id", "segment_id", "reviewer", "reviewed_at", "decision"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "review_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "decision": {
      "type": "string",
      "enum": ["approve", "reject", "ambiguous"]
    },
    "notes": { "type": ["string", "null"] }
  }
}
