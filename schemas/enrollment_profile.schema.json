{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aarya-voice-lab/schemas/enrollment_profile.schema.json",
  "title": "AARYA Voice Lab Speaker Profile (Phase 3)",
  "description": "A versioned speaker profile. Holds a REFERENCE to a stored embedding (id + hash) and never the vector itself, so profiles can be read and diffed without handling biometric data. Profiles are immutable: improving one creates a new version and marks the old superseded.",
  "type": "object",
  "required": [
    "schema_version", "profile_id", "role", "version", "profile_version_key",
    "enrollment_state", "provider_is_synthetic", "calibration_state",
    "provenance", "fingerprint", "created_at", "is_usable"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "profile_id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "enum": ["target_speaker", "operator", "synthetic_speaker", "unknown"] },
    "version": { "type": "integer", "minimum": 1 },
    "profile_version_key": { "type": "string" },
    "enrollment_state": {
      "type": "string",
      "enum": ["draft", "pending_human_approval", "enrolled", "superseded", "revoked"]
    },
    "embedding_id": { "type": ["string", "null"] },
    "embedding_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "embedding_dimension": { "type": ["integer", "null"], "minimum": 1 },
    "provider_name": { "type": ["string", "null"] },
    "provider_version": { "type": ["string", "null"] },
    "provider_is_synthetic": {
      "type": "boolean",
      "description": "True when built with a synthetic provider. Propagates to every downstream artifact so development results can never be read as real identity conclusions."
    },
    "calibration_state": { "type": "string", "enum": ["UNCALIBRATED", "PROVISIONAL", "CALIBRATED"] },
    "calibration_id": { "type": ["string", "null"] },
    "sample_count": { "type": "integer", "minimum": 0 },
    "total_duration_seconds": { "type": "number", "minimum": 0 },
    "channel_conditions": { "type": "array", "items": { "type": "string" } },
    "display_name": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "string" },
    "superseded_by": { "type": ["string", "null"] },
    "is_usable": { "type": "boolean" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_name", "strategy_version", "processing_version"],
      "properties": {
        "strategy_name": { "type": "string" },
        "strategy_version": { "type": "string" },
        "seed_segment_ids": { "type": "array", "items": { "type": "string" } },
        "source_file_ids": { "type": "array", "items": { "type": "string" } },
        "candidate_manifest_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"] },
        "processing_version": { "type": "string" }
      }
    }
  }
}
