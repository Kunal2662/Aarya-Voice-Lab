{
  "$schema": "internal://aarya-voice-lab/tokens/typography",
  "description": "Typography hierarchy. Pixel/bitmap type is decorative ONLY (labels, section glyphs, empty-state art) and must never carry critical or long-form text — critical and long text always use the readable family. No font files are bundled in VL-D0; families below are system stacks so the contract is usable before any font asset is chosen.",
  "families": {
    "readable": "-apple-system, 'Segoe UI', Roboto, 'Inter', 'Helvetica Neue', Arial, sans-serif",
    "monospace": "'SFMono-Regular', 'JetBrains Mono', Consolas, 'Liberation Mono', Menlo, monospace",
    "pixel-decorative": "'Press Start 2P', 'VT323', var(--avl-font-monospace)"
  },
  "rules": {
    "pixel_decorative_allowed_on": ["section-glyphs", "empty-state-art", "app-icon", "loading-motif"],
    "pixel_decorative_forbidden_on": ["body-text", "form-labels", "status-text", "error-messages", "any-text-longer-than-one-short-word", "the-sole-carrier-of-any-information"]
  },
  "scale": {
    "display": { "size": "2.5rem", "line-height": "1.15", "weight": 600, "family": "readable" },
    "title": { "size": "1.75rem", "line-height": "1.25", "weight": 600, "family": "readable" },
    "heading": { "size": "1.25rem", "line-height": "1.3", "weight": 600, "family": "readable" },
    "subheading": { "size": "1.05rem", "line-height": "1.4", "weight": 500, "family": "readable" },
    "body": { "size": "0.95rem", "line-height": "1.55", "weight": 400, "family": "readable" },
    "body-small": { "size": "0.85rem", "line-height": "1.5", "weight": 400, "family": "readable" },
    "caption": { "size": "0.75rem", "line-height": "1.4", "weight": 500, "family": "readable" },
    "code": { "size": "0.85rem", "line-height": "1.5", "weight": 400, "family": "monospace" },
    "pixel-label": { "size": "0.7rem", "line-height": "1.6", "weight": 400, "family": "pixel-decorative" }
  },
  "min_scalable_rem": 0.75,
  "notes": "All sizes use rem so they scale with the user's browser/OS text-size preference. No component may fix text size in px."
}
